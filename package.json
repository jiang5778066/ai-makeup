{
  "name": "ai-makeup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:image": "tsx scripts/check-image-generation.ts",
    "release": "tsx scripts/release/cli.ts",
    "release:verify": "vitest run --config scripts/release/vitest.config.ts",
    "db:migrate": "tsx scripts/db/cli.ts migrate",
    "db:status": "tsx scripts/db/cli.ts status",
    "release:tools:install": "npm ci --prefix scripts/release/tools",
    "release:audit": "tsx scripts/release/audit-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1053.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
