# =========================================
# AI Makeup Studio - environment variables
# Copy to .env.local for local dev
# =========================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- DB + Auth (Supabase) ----
# Get these from Supabase project → Settings → API + Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (optional; Supabase has built-in sender for dev) ----
RESEND_API_KEY=
EMAIL_FROM="AI Makeup Studio <noreply@yourdomain.com>"

# ---- AI Generation (fal.ai) ----
FAL_KEY=

# ---- Storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=makeup-originals
R2_BUCKET_RESULTS=makeup-results
# Public CDN base URL for results (optional, otherwise we sign URLs)
R2_PUBLIC_BASE_URL=

# ---- Moderation (AWS Rekognition) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Queue (Inngest) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Paid beta kill switches ----
DISABLE_CHECKOUT=0
DISABLE_GENERATION=0
DAILY_AI_SPEND_CAP_CENTS=2000
AI_GENERATION_ESTIMATE_CENTS=10

# ---- Payments: Creem (only payment provider) ----
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_CREDITS_100=
# Optional for Creem test environments; production defaults to https://api.creem.io
CREEM_API_BASE=

# ---- Legal/contact ----
SUPPORT_EMAIL=support@yourdomain.com
PRIVACY_EMAIL=privacy@yourdomain.com
DMCA_EMAIL=dmca@yourdomain.com
